    private static string SslClass(SiteDto s) => s.SslDaysLeft switch { null => "health-healthy", <= 0 => "health-critical", <= 14 => "health-warning", _ => "health-healthy" };
    private static string SslDot(SiteDto s) => s.SslDaysLeft switch { null => "bg-healthy", <= 0 => "bg-critical", <= 14 => "bg-warning", _ => "bg-healthy" };
    private static string SslLabel(SiteDto s) => s.SslDaysLeft switch { null => "SSL", <= 0 => "expired", { } d => $"SSL · {d}d" };
